# ============================================================
# KronborgMarine Middleware — Miljøvariable
# Kopiér denne fil til .env.local og udfyld værdierne
# ============================================================

# --- Supabase ---
# Find disse i dit Supabase projekt under Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- E-mail (Resend) — login-links, ordremails, påmindelser ---
RESEND_API_KEY=
# Afsender — domænet skal være verificeret i Resend
# Midlertidigt onboarding@resend.dev (leverer kun til Resend-kontoens egen e-mail)
EMAIL_FROM=LoveSailing <onboarding@resend.dev>

# --- admind POS (tilføjes når API docs foreligger) ---
ADMIND_API_URL=
ADMIND_API_KEY=

# --- App ---
# Bruges til webhook-URLs (ngrok URL til lokal udvikling, Vercel URL i produktion)
NEXT_PUBLIC_APP_URL=http://localhost:3000
